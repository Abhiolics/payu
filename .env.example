NODE_ENV=development
PORT=5003
# Generate both using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=
POSTGRES_PASSWORD=
# Direct Node execution uses DATABASE_URL. Docker Compose overrides it for its database.
DATABASE_URL=postgres://pay:YOUR_DATABASE_PASSWORD@localhost:5432/pay
PUBLIC_API_URL=http://localhost:5003
CORS_ORIGINS=http://localhost:3000
# Leave 0 unless a known reverse proxy is in front of the API.
TRUST_PROXY_HOPS=0
# Development Mailpit. Use your SMTP provider in production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pay <no-reply@example.test>
